//Palindrome (Ignore case and special characters)

#include <stdio.h>
#include <ctype.h>
#include <string.h>

int main() {
    char str[100], temp[100];
    int i, j = 0;

    printf("Enter string: ");
    fgets(str, sizeof(str), stdin);

    for(i = 0; str[i]; i++) {
        if(isalnum(str[i]))
            temp[j++] = tolower(str[i]);
    }
    temp[j] = '\0';

    int start = 0, end = j - 1;

    while(start < end) {
        if(temp[start] != temp[end]) {
            printf("Not Palindrome");
            return 0;
        }
        start++;
        end--;
    }

    printf("Palindrome");
    return 0;
}
