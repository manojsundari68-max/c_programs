#include <stdio.h>
#include <stdlib.h>

int main()
{
    FILE *fin, *fout;
    int arr[100], n = 0, temp;

    fin = fopen("input.txt", "r");

    if(fin == NULL){
        printf("Error opening input file\n");
        return 1;
    }

    while(fscanf(fin, "%d", &arr[n]) == 1){
        n++;
    }

    fclose(fin);

    // Bubble Sort
    for(int i = 0; i < n - 1; i++){
        for(int j = 0; j < n - i - 1; j++){
            if(arr[j] > arr[j + 1]){
                temp = arr[j];
                arr[j] = arr[j + 1];
                arr[j + 1] = temp;
            }
        }
    }

    fout = fopen("output.txt", "w");

    if(fout == NULL){
        printf("Error opening output file\n");
        return 1;
    }

    for(int i = 0; i < n; i++){
        fprintf(fout, "%d ", arr[i]);
    }

    fclose(fout);

    printf("Numbers sorted and written to output.txt\n");

    return 0;
}
