//quick sort

#include <stdio.h>
int partition(int arr[],int low,int high){
    int i=low-1;
    int temp;
    int pivot=arr[high];
    
    for(int j=low;j<high;j++){
        if(arr[j]<pivot)
        {
            i++;
        temp=arr[i];
        arr[i]=arr[j];
        arr[j]=temp;
        
    }
}
   temp=arr[i+1];
   arr[i+1]=arr[high];
   arr[high]=temp;
   return i+1;
    
}
void quicksort(int arr[],int low,int high){
    if(low<high){
    int pi=partition(arr,low,high);
    
    quicksort(arr,low,pi-1);
    quicksort(arr,pi+1,high);
    
}}

int main()
{
  int n;
  scanf("%d",&n);
  int arr[n];
  for(int i=0;i<n;i++){
      scanf("%d",&arr[i]);
  }
  quicksort(arr,0,n-1);
  
  for(int i=0;i<n;i++){
      printf("%d ",arr[i]);
  }
}
