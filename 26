//Check 9×9 Unique Numbers

#include <stdio.h>

int main(){
    int a[9][9];
    int check[10];
    
    for(int i=0;i<9;i++){
        for(int j=0;j<9;j++){
            scanf("%d",&a[i][j]);
        }
    }
    for(int i=0;i<9;i++)
    {
        for(int k=1;k<=9;k++)
            check[k]=0;
        
        for(int j=0;j<9;j++)
        check[a[i][j]]++;
        
        for(int k=1;k<=9;k++)
        {
            if(check[k]!=1){
                printf("invalid");
                return 0;
            }
        }
    }
    printf("valid");
}
