//Linear Search

#include <stdio.h>

int main() {
    int arr[100], n, target;
    int position = -1;

    printf("Enter the number of elements: ");
    scanf("%d", &n);

    printf("Enter %d elements:\n", n);
    for(int i = 0; i < n; i++) {
        scanf("%d", &arr[i]);
    }

    printf("Enter the target value: ");
    scanf("%d", &target);

    // Linear Search
    for(int i = 0; i < n; i++) {
        if(arr[i] == target) {
            position = i;
            break;
        }
    }

    if(position != -1) {
        printf("Target found at position %d\n", position + 1);
    } else {
        printf("Target not found in the array.\n");
    }

    return 0;
}
