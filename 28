//Employee Salary Payout

#include <stdio.h>
#include<stdlib.h>

struct employee{
    int id;
    char name[20];
    float salary;
};

int main(){
    struct employee e[3];
    int high=0;
    float total=0;
    
    for(int i=0;i<3;i++){
        scanf("%d%s%f",&e[i].id,e[i].name,&e[i].salary);
        total+=e[i].salary;
        if(e[i].salary>e[high].salary){
            high=i;
        }
    }
    printf("%f ",total);
    printf("%s",e[high].name);
    
}
