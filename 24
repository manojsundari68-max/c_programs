//City Names Sort Alphabetically

#include <stdio.h>
#include<string.h>
#include<stdlib.h>

int main(){
    char *city[3];
    char temp[20];
    
    city[0]=strdup("chennai");
    city[1]=strdup("bangalore");
    city[2]=strdup("delhi");
    
    for(int i=0;i<2;i++){
        for(int j=i+1;j<3;j++){
            if(strcmp(city[i],city[j])>0){
                strcpy(temp,city[i]);
                strcpy(city[i],city[j]);
                strcpy(city[j],temp);
            }
        }
    }
    for(int i=0;i<3;i++){
    printf("%s ",city[i]);
}}  
