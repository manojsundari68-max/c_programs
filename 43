//valid paranthesis

#include <stdio.h>
#include <string.h>

#define MAX 100

char stack[MAX];
int top = -1;

// Push operation
void push(char ch) {
    stack[++top] = ch;
}

// Pop operation
char pop() {
    if (top == -1)
        return '\0';
    return stack[top--];
}

// Check matching pair
int isMatchingPair(char open, char close) {
    return ((open == '(' && close == ')') ||
            (open == '{' && close == '}') ||
            (open == '[' && close == ']'));
}

int main() {
    char expr[100];

    printf("Enter an expression: ");
    scanf("%s", expr);

    int balanced = 1;

    for (int i = 0; i < strlen(expr); i++) {
        char ch = expr[i];

        // Push opening brackets
        if (ch == '(' || ch == '{' || ch == '[') {
            push(ch);
        }

        // Process closing brackets
        else if (ch == ')' || ch == '}' || ch == ']') {
            char open = pop();

            if (open == '\0' || !isMatchingPair(open, ch)) {
                balanced = 0;
                break;
            }
        }
    }

    // If stack is not empty, brackets are unbalanced
    if (top != -1)
        balanced = 0;

    if (balanced)
        printf("Expression is Balanced\n");
    else
        printf("Expression is Not Balanced\n");

    return 0;
}
