//Student Structure and Topper

#include <stdio.h>

struct Student {
    int roll;
    char name[30];
    float marks;
};

int main() {
    struct Student s[5];
    int top = 0;

    for(int i = 0; i < 5; i++) {
        scanf("%d%s%f",
              &s[i].roll,
              s[i].name,
              &s[i].marks);
    }

    for(int i = 1; i < 5; i++)
        if(s[i].marks > s[top].marks)
            top = i;

    printf("Topper: %s %.2f",
           s[top].name,
           s[top].marks);

    return 0;
}
