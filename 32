//Using typedef to Create an Alias for a Structure

#include <stdio.h>

// Structure with typedef alias
typedef struct {
    int id;
    char name[50];
    float salary;
} Employee;

int main() {
    // Using alias Employee instead of struct Employee
    Employee emp;

    printf("Enter Employee ID: ");
    scanf("%d", &emp.id);

    printf("Enter Employee Name: ");
    scanf("%s", emp.name);

    printf("Enter Salary: ");
    scanf("%f", &emp.salary);

    printf("\nEmployee Details\n");
    printf("ID     : %d\n", emp.id);
    printf("Name   : %s\n", emp.name);
    printf("Salary : %.2f\n", emp.salary);

    return 0;
}
