#include <stdio.h>
#include <string.h>

int main() {
    char str[100], stack[100];
    int top = -1, i, len, flag = 1;

    printf("Enter a string: ");
    scanf("%s", str);

    len = strlen(str);

    for(i = 0; i < len; i++)
        stack[++top] = str[i];

    for(i = 0; i < len; i++) {
        if(str[i] != stack[top--]) {
            flag = 0;
            break;
        }
    }

    if(flag)
        printf("Palindrome");
    else
        printf("Not Palindrome");

    return 0;
}
